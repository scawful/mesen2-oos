+    def offer_rom(self, path: str, label: str | None = None, notes: str | None = None) -> dict | None:
+        """Offer a new ROM to the player: the GUI shows a Load now / Later banner."""
+        rom_path = Path(path).expanduser().resolve()
+        if not rom_path.is_file():
+            self.last_error = f"ROM not found: {rom_path}"
+            return None
+        params: dict = {"path": str(rom_path)}
+        if label:
+            params["label"] = label
+        if notes:
+            params["notes"] = notes
+        return self._rom_offer_command("OFFER_ROM", params)
+
+    def rom_offer_status(self) -> dict | None:
+        return self._rom_offer_command("OFFER_ROM_STATUS", {})
+
+    def clear_rom_offer(self) -> dict | None:
+        return self._rom_offer_command("OFFER_ROM_CLEAR", {})
+
+    def load_rom_live(self, path: str | None = None, label: str | None = None, state: bool = True) -> dict | None:
+        """Load a ROM keeping the running game's .srm; no path accepts the pending offer."""
+        params: dict = {"state": str(state).lower()}
+        if path:
+            rom_path = Path(path).expanduser().resolve()
+            if not rom_path.is_file():
+                self.last_error = f"ROM not found: {rom_path}"
+                return None
+            params["path"] = str(rom_path)
+        if label:
+            params["label"] = label
+        return self._rom_offer_command("LOAD_ROM_LIVE", params, timeout=30.0)
+
+    def _rom_offer_command(self, command: str, params: dict, timeout: float = 5.0) -> dict | None:
+        res = self.bridge.send_command(command, params, timeout=timeout)
+        if res.get("success"):
+            self.last_error = ""
+            data = res.get("data")
+            return data if isinstance(data, dict) else {}
+        self.last_error = res.get("error", "") or f"{command} failed"
+        return None
+
