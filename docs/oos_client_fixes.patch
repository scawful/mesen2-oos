+def _pid_from_status_file(socket_path: str) -> int | None:
+    """Named instance sockets carry no pid; Mesen writes it to <socket>.status."""
+    status_path = Path(socket_path).with_suffix(".status")
+    try:
+        return int(json.loads(status_path.read_text()).get("pid"))
+    except (OSError, ValueError, TypeError):
+        return None
