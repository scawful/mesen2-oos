<Window
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:Mesen.ViewModels"
	xmlns:l="using:Mesen.Localization"
	mc:Ignorable="d"
	x:Class="Mesen.Windows.OracleDiagnosticsWindow"
	x:DataType="vm:OracleDiagnosticsViewModel"
	Title="Oracle Diagnostics"
	Width="700" Height="500"
	MinWidth="500" MinHeight="300"
	WindowStartupLocation="CenterOwner"
>
	<Design.DataContext>
		<vm:OracleDiagnosticsViewModel />
	</Design.DataContext>

	<DockPanel Margin="10">
		<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0 0 0 8">
			<Button Content="Run ZSOW Status" Click="OnRunZsowClick" IsEnabled="{Binding !IsRunning}" />
			<Button Content="Run Day/Night Status" Click="OnRunDayNightClick" IsEnabled="{Binding !IsRunning}" />
			<Button Content="Copy" Click="OnCopyClick" />
			<Button Content="Save Log..." Click="OnSaveLogClick" />
			<Button Content="Clear" Click="OnClearClick" />
		</StackPanel>

		<TextBox
			x:Name="OutputBox"
			AcceptsReturn="True"
			Text="{Binding DiagnosticsOutput, Mode=OneWay}"
			IsReadOnly="True"
			TextWrapping="NoWrap"
			FontFamily="{DynamicResource MesenFont}"
			FontSize="{DynamicResource MesenFontSize}"
			ScrollViewer.HorizontalScrollBarVisibility="Auto"
			ScrollViewer.VerticalScrollBarVisibility="Auto"
			VerticalAlignment="Stretch"
		/>
	</DockPanel>
</Window>
