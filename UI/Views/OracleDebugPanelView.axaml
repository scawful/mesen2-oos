<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:Mesen.ViewModels"
	mc:Ignorable="d" d:DesignWidth="760"
	x:Class="Mesen.Views.OracleDebugPanelView"
	x:DataType="vm:OracleDebugPanelViewModel"
	IsVisible="{Binding IsStripVisible}"
>
	<Design.DataContext>
		<vm:OracleDebugPanelViewModel />
	</Design.DataContext>

	<UserControl.Styles>
		<Style Selector="TextBlock.value">
			<Setter Property="FontFamily" Value="{DynamicResource MesenMonospaceFont}" />
			<Setter Property="FontSize" Value="{DynamicResource MesenMonospaceFontSize}" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style Selector="TextBlock.dim">
			<Setter Property="Foreground" Value="{DynamicResource ThemeForegroundLowBrush}" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.strip">
			<Setter Property="Padding" Value="8,1" />
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="Margin" Value="4,0,0,0" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
	</UserControl.Styles>

	<Border
		Background="{DynamicResource ThemeBackgroundBrush}"
		BorderBrush="{DynamicResource ThemeBorderLowBrush}"
		BorderThickness="0,0,0,1"
		Padding="8,3"
	>
		<Grid ColumnDefinitions="*,Auto">
			<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" ClipToBounds="True">
				<TextBlock Classes="value" Text="{Binding LocationText}" />
				<TextBlock Classes="value" Text="{Binding LinkText}" />
				<TextBlock Classes="value" Text="{Binding HealthText}" />
				<TextBlock Classes="value dim" Text="{Binding FormText}" />
				<TextBlock Classes="value dim" Text="{Binding FrameText}" />
				<TextBlock Classes="dim" Text="{Binding StatusLine}" TextTrimming="CharacterEllipsis" MaxWidth="320" ToolTip.Tip="{Binding StatusLine}" />
			</StackPanel>
			<StackPanel Grid.Column="1" Orientation="Horizontal">
				<Button Classes="strip" Content="{Binding ToolsButtonText}" Click="OnToggleExpandedClick" ToolTip.Tip="Show or hide the Oracle tools pane (Cmd/Ctrl+Shift+O)" />
				<Button Classes="strip" Content="Hide" Click="OnToggleVisibilityClick" ToolTip.Tip="Hide the Oracle strip (Cmd/Ctrl+Shift+H shows it again)" />
			</StackPanel>
		</Grid>
	</Border>
</UserControl>
