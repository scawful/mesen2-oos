<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.NoTitleBar.Fullscreen">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/night_moss</item>
        <item name="android:colorBackground">@color/night_moss</item>
        <item name="android:keepScreenOn">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="OracleHudText">
        <item name="android:textColor">@color/hud_ink</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="OracleTitle">
        <item name="android:textColor">@color/triforce_gold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.22</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="OracleField" parent="android:Widget.EditText">
        <item name="android:textColor">@color/parchment</item>
        <item name="android:textColorHint">@color/hud_ink</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:background">@drawable/menu_row</item>
        <item name="android:padding">8dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:focusable">false</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:importantForAutofill">no</item>
    </style>

    <style name="OracleMenuButton" parent="android:Widget.Button">
        <item name="android:textColor">@color/parchment</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:background">@drawable/menu_row</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
    </style>
</resources>
