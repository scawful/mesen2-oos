<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#FF29496B" />
            <stroke android:width="2dp" android:color="@color/triforce_gold" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#FF29496B" />
            <stroke android:width="2dp" android:color="@color/parchment" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#14181F" />
            <stroke android:width="1dp" android:color="#FF48515F" />
        </shape>
    </item>
</selector>
